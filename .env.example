# Copy to .env. Variables already set in your shell take precedence.

# Any OpenAI-compatible endpoint works. Ollama (free, local) is the default.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=unused
LLM_CONTEXT_TOKENS=32000
LLM_REPLY_TOKENS=2000

# The CRM, plus the outputs of ClaimReplay and ClaimScout (both optional).
CRM_DB_PATH=../claim-replay/data/crm.sqlite3
REPLAY_DB_PATH=../claim-replay/data/replays.sqlite3
PLAYBOOK_DB_PATH=../claim-scout/data/playbooks.sqlite3
CALL_BRIEFS_DB_PATH=data/call_briefs.sqlite3

# Comma-separated keys accepted in the X-API-Key header. Empty: no key needed (local use only).
API_KEYS=
